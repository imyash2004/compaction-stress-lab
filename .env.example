# ---- OpenAI models on Microsoft Foundry (Azure OpenAI v1 API) ----
AZURE_OPENAI_ENDPOINT=                 # https://<resource>.openai.azure.com/openai/v1
AZURE_API_KEY=
OPENAI_DEPLOYMENTS=gpt-6.1-sol,gpt-6-sol,gpt-6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.4
LAB_OPENAI_EFFORT=medium               # low | medium | high | default (= don't send)

# ---- Claude ----
ANTHROPIC_API_KEY=                     # direct Anthropic API (preferred: on-demand compaction)
CLAUDE_BACKEND=anthropic               # anthropic | openrouter | foundry
CLAUDE_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
OPENROUTER_API_KEY=                    # only for CLAUDE_BACKEND=openrouter (OPEN_ROUTER_API_KEY also accepted)
LAB_CLAUDE_EFFORT=medium               # low | medium | high | xhigh | max | default
CLAUDE_COMPACTION_MODE=auto            # auto (uses `check` result) | on_demand | threshold
OPENROUTER_PROVIDER=anthropic          # pinned upstream provider, no fallbacks

# ---- Budget / timeouts ----
MAX_USD_PER_EXPERIMENT=50
REQUEST_TIMEOUT_S=900
